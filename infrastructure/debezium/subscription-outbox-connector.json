{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",

  "database.hostname": "subscription-db",
  "database.port": "5432",
  "database.user": "${env:SUBSCRIPTION_DB_USER}",
  "database.password": "${env:SUBSCRIPTION_DB_PASSWORD}",
  "database.dbname": "${env:SUBSCRIPTION_DB_NAME}",

  "plugin.name": "pgoutput",
  "publication.autocreate.mode": "filtered",
  "publication.name": "subscription_outbox_publication",
  "slot.name": "subscription_outbox_slot",

  "table.include.list": "public.outbox",

  "topic.prefix": "subscription",

  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.route.by.field": "type",
  "transforms.outbox.route.topic.replacement": "outbox.event.${routedByValue}",
  "transforms.outbox.table.field.event.key": "aggregate_id",
  "transforms.outbox.table.expand.json.payload": "true",
  "transforms.outbox.table.fields.additional.placement": "trace_id:header:traceparent",

  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false"
}
