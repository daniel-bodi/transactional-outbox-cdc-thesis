# Copy this file to .env and adjust values as needed.
# Both docker-compose and the Spring Boot services read from .env in this directory.
# The values address the stack from the host (services started with spring-boot:run);
# inside the compose network the service containers get their container hostnames instead.

# --- subscription-service ---
SUBSCRIPTION_SERVICE_PORT=8080
SUBSCRIPTION_DB_HOST=localhost
SUBSCRIPTION_DB_PORT=5432
SUBSCRIPTION_DB_NAME=subscription
SUBSCRIPTION_DB_USER=subscription
SUBSCRIPTION_DB_PASSWORD=subscription

# --- payment-service ---
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5433
PAYMENT_DB_NAME=payment
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=payment

# --- psp-mock-service ---
PSP_MOCK_HOST=localhost
PSP_MOCK_PORT=8082
PSP_DB_HOST=localhost
PSP_DB_PORT=5434
PSP_DB_NAME=psp
PSP_DB_USER=psp
PSP_DB_PASSWORD=psp

# --- kafka ---
KAFKA_HOST=localhost
KAFKA_PORT=29092
KAFKA_UI_PORT=8081
KAFKA_UI_CLUSTER_NAME=thesis-cluster
KAFKA_CONNECT_PORT=8083
